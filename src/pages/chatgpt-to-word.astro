  </div>
</Layout>

<style>
  #markdown-input,
  #preview-container {
    height: 100%;
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"
></script>

<!-- KaTeX for Math Equations -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
/>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>

<!-- html-docx-js for Word Download -->
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/html-docx-js@0.3.1/dist/html-docx.min.js"
></script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("markdown-input");
    const preview = document.getElementById("markdown-preview");
    const inputPlaceholder = document.getElementById("input-placeholder");
    const outputPlaceholder = document.getElementById("output-placeholder");
    const downloadBtn = document.getElementById("download-btn");
    const copyBtn = document.getElementById("copy-btn");
    const pasteBtn = document.getElementById("paste-btn");
    const clearBtn = document.getElementById("clear-btn");

    function renderMath(text) {
      if (!text) return "";

      // 1. Block Math: $$...$$
      text = text.replace(/\$\$([\s\S]+?)\$\$/g, function (match, math) {
        try {
          return katex.renderToString(math.trim(), {
            displayMode: true,
            throwOnError: false,
          });
        } catch (e) {
          return match;
        }
      });

      // 2. Block Math: \[...\]
      text = text.replace(/\\\[([\s\S]+?)\\\]/g, function (match, math) {
        try {
          return katex.renderToString(math.trim(), {
            displayMode: true,
            throwOnError: false,
          });
        } catch (e) {
          return match;
        }
      });

      // 3. Inline Math: $...$
      text = text.replace(
        /(?<!\$)\$(?!\$)([^\$\n]+?)\$(?!\$)/g,
        function (match, math) {
          try {
            return katex.renderToString(math.trim(), {
              displayMode: false,
              throwOnError: false,
            });
          } catch (e) {
            return match;
          }
        },
      );

      // 4. Inline Math: \(...\)
      text = text.replace(/\\\(([\s\S]+?)\\\)/g, function (match, math) {
        try {
          return katex.renderToString(math.trim(), {
            displayMode: false,
            throwOnError: false,
          });
        } catch (e) {
          return match;
        }
      });

      return text;
    }

    function updatePreview() {
      if (!input) return;
      const hasContent = !!input.value.trim();

      if (hasContent) {
        if (inputPlaceholder) inputPlaceholder.style.display = "none";
        if (outputPlaceholder) outputPlaceholder.style.display = "none";
        if (preview) {
          const textWithMath = renderMath(input.value);
          preview.innerHTML = marked.parse(textWithMath);
        }
      } else {
        if (inputPlaceholder) inputPlaceholder.style.display = "flex";
        if (outputPlaceholder) outputPlaceholder.style.display = "flex";
        if (preview) preview.innerHTML = "";
      }
    }

    updatePreview();

    if (input) {
      input.addEventListener("input", updatePreview);
    }

    if (pasteBtn) {
      pasteBtn.addEventListener("click", function () {
        navigator.clipboard
          .readText()
          .then((text) => {
            if (input) {
              input.value = text;
              updatePreview();
            }
          })
          .catch((err) => {
            console.error("Failed to read clipboard:", err);
            alert("Unable to access clipboard.");
          });
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        if (input) {
          input.value = "";
          updatePreview();
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", function () {
        if (!preview) return;

        // Copy inner HTML/Text mechanism
        // For Word, copying rich HTML is best
        const blob = new Blob([preview.innerHTML], { type: "text/html" });
        const item = new ClipboardItem({ "text/html": blob });

        navigator.clipboard
          .write([item])
          .then(() => {
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Copied!
            `;
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
            }, 2000);
          })
          .catch((err) => {
            console.error("Copy failed", err);
            alert("Failed to copy content.");
          });
      });
    }

    if (downloadBtn) {
      downloadBtn.addEventListener("click", function () {
        if (!preview) return;

        // Generate Word doc from the preview HTML
        // html-docx-js expects full page HTML structure usually for best results
        const content = `
          <!DOCTYPE html>
          <html>
            <head>
              <meta charset="UTF-8">
              <style>
                body { font-family: Calibri, sans-serif; font-size: 11pt; }
              </style>
            </head>
            <body>
              ${preview.innerHTML}
            </body>
          </html>
        `;

        if (typeof htmlDocx !== "undefined") {
          const converted = htmlDocx.asBlob(content, {
            orientation: "portrait",
          });
          const url = URL.createObjectURL(converted);
          const link = document.createElement("a");
          link.href = url;
          link.download = "chatgpt-conversation.docx";
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
        } else {
          console.error("html-docx library not loaded");
          alert("Converter library not loaded. Please refresh.");
        }
      });
    }
  });
</script>
