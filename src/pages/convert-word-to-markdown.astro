                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path>
                                </svg>
                                Video Tutorial
                            </h3>
                            <div
                                class="relative w-full"
                                style="padding-bottom: 56.25%;"
                            >
                                <iframe
                                    class="absolute top-0 left-0 w-full h-full rounded-lg border border-gray-200"
                                    src="https://www.youtube.com/embed/VIDEO_ID_HERE"
                                    title="How to Convert Word to Markdown - Video Tutorial"
                                    frameborder="0"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen></iframe>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Method 2 Card -->
                <div
                    class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 mb-6"
                >
                    <div class="mb-6">
                        <h2
                            class="text-xl font-bold text-gray-900 flex items-center gap-2"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6 text-green-600"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
                                ></path>
                            </svg>
                            Method 2: Using the Google Docs Add-on
                        </h2>
                        <p class="text-gray-600 mt-2 ml-8">
                            Recommended for <span
                                class="text-green-600 underline"
                                >frequent users</span
                            >. If you use Google Docs, this is the most
                            efficient way.
                        </p>
                    </div>
                    <ol class="space-y-4 ml-8">
                        <li class="flex items-start gap-3">
                            <span
