<style>
    /* Basic contenteditable styling */
    [contenteditable]:empty:before {
        content: attr(placeholder);
        color: #9ca3af;
        display: block; /* For Firefox */
    }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/turndown/dist/turndown.js"
></script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
        const inputDiv = document.getElementById("rich-input");
        const outputTextarea = document.getElementById("markdown-output");
        const placeholder = document.getElementById("input-placeholder");
        const copyBtn = document.getElementById("copy-md-btn");
        const pasteBtn = document.getElementById("paste-btn");
        const clearBtn = document.getElementById("clear-btn");
        const downloadBtn = document.getElementById("download-md-btn");

        // Initialize Turndown Service
        let turndownService;
        if (typeof TurndownService !== "undefined") {
            turndownService = new TurndownService();
        } else {
            console.error("TurndownService not loaded");
        }

        function convertToMarkdown(html) {
            if (!html || !turndownService) return "";

            // Pre-process: Protect math blocks from Turndown escaping
            const mathTokens = [];

            // Helper to tokenize math
            const tokenize = (match) => {
                // We create a temp div to extract the raw text content of the math block
                // This strips any HTML tags that might have polluted the math (like <br> or <span>)
                // and gets us back to clean LaTeX
                const temp = document.createElement("div");
                temp.innerHTML = match;
                // Preserve the raw math text
                mathTokens.push(temp.textContent || temp.innerText || match);
                // Return a safe token that Turndown won't escape (alphanumeric)
                return "MATHPH" + (mathTokens.length - 1) + "ENDMATHPH";
            };

            // 1. Protect Block Math $$...$$
            // Use [\s\S] to match across newlines
            let protectedHtml = html.replace(/\$\$([\s\S]+?)\$\$/g, tokenize);

            // 2. Protect Inline Math $...$
            // Negative lookaround to ensure we don't match $$ or empty $
            protectedHtml = protectedHtml.replace(
                /(?<!\$)\$(?!\$)([^\$\n]+?)\$(?!\$)/g,
                tokenize,
            );

            // Convert to Markdown
            let markdown = turndownService.turndown(protectedHtml);

            // Restore Math Tokens
            mathTokens.forEach((token, index) => {
                const placeholder = "MATHPH" + index + "ENDMATHPH";
                // Replace the placeholder with the original raw math
                markdown = markdown.replace(placeholder, token);
            });

            return markdown;
        }

        function updateOutput() {
            if (!inputDiv || !outputTextarea) return;

            const content = inputDiv.innerHTML;
            const textContent = inputDiv.textContent;

            if (!textContent.trim() && !inputDiv.querySelector("img")) {
                outputTextarea.value = "";
                if (placeholder) placeholder.style.display = "block";
            } else {
                if (placeholder) placeholder.style.display = "none";
                outputTextarea.value = convertToMarkdown(content);
            }
        }

        if (inputDiv) {
            inputDiv.addEventListener("input", updateOutput);

            // Handle paste events
            inputDiv.addEventListener("paste", function (e) {
                // Allow browser to handle paste
                setTimeout(updateOutput, 0);
            });
        }

        if (pasteBtn) {
            pasteBtn.addEventListener("click", async function () {
                inputDiv.focus();
                try {
                    alert(
                        "Please click inside the Input box and press Ctrl+V / Cmd+V to paste.",
                    );
                } catch (e) {
                    alert("Please paste content manually.");
                }
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener("click", function () {
                if (inputDiv) {
                    inputDiv.innerHTML = "";
                    updateOutput();
                    inputDiv.focus();
                }
            });
        }

        if (copyBtn) {
            copyBtn.addEventListener("click", function () {
                if (!outputTextarea || !outputTextarea.value) return;

                outputTextarea.select();
                navigator.clipboard
                    .writeText(outputTextarea.value)
                    .then(() => {
                        const originalText = copyBtn.innerHTML;
                        copyBtn.innerHTML = `Copied!`;
                        setTimeout(() => {
                            copyBtn.innerHTML = originalText;
                        }, 2000);
                    })
                    .catch((err) => {
                        console.error("Copy failed", err);
                    });
            });
        }

        if (downloadBtn) {
            downloadBtn.addEventListener("click", function () {
                if (!outputTextarea || !outputTextarea.value) return;
                const blob = new Blob([outputTextarea.value], {
                    type: "text/markdown",
                });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = "word-document.md";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            });
        }
    });
</script>
