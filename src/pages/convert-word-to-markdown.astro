                                    >
                                </li>
                            </ol>
                        </div>

                        <!-- Video (Span 1) -->
                        <div class="lg:col-span-1">
                            <h3
                                class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 text-red-500"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
