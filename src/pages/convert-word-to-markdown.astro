---
import Layout from "~/layouts/PageLayout.astro";
import Sidebar from "~/components/widgets/Sidebar.astro";

const metadata = {
    title: "Convert Word to Markdown Online - Free",
    description:
        "Convert content from Microsoft Word to Markdown and preview it interactively.",
};
---

<Layout metadata={metadata}>
    <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col lg:flex-row gap-6">
            <!-- Main content area -->
            <div class="flex-1">
                <!-- Header Section -->
                <div class="text-center mb-6">
                    <h1
                        class="text-2xl md:text-3xl font-bold text-blue-600 mb-3"
                    >
                        Convert Word to Markdown Online - Free
                    </h1>
                    <p class="text-gray-600 text-lg">
                        Instantly transform Microsoft Word documents into clean
                        Markdown
                    </p>
                </div>

                <!-- ChatGPT to Word Extension Promo -->
                <div
                    class="bg-blue-50 border border-blue-200 rounded-xl p-4 w-full max-w-5xl mx-auto mb-6 shadow-sm flex flex-col md:flex-row items-center gap-4"
                >
                    <div class="flex-shrink-0">
                        <a
                            href="https://chromewebstore.google.com/detail/chatgpt-to-word-or-pdf/mjdmggegbkookpcmbdllcnbfboikcbop"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:opacity-90 transition-opacity duration-200 block"
                        >
                            <img
                                src="/chrome-badge.png"
                                alt="Get it from the Google Chrome Webstore"
                                class="h-12"
                            />
                        </a>
                    </div>
                    <div class="text-sm text-gray-700 leading-relaxed">
                        <ul class="list-disc pl-4 space-y-1">
                            <li>
                                <strong>Using ChatGPT?</strong> Try the
                                <a
                                    href="https://chromewebstore.google.com/detail/chatgpt-to-word-or-pdf/mjdmggegbkookpcmbdllcnbfboikcbop"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-blue-600 font-semibold hover:underline"
                                >
                                    ChatGPT to Word
                                </a>
                                extension to export ChatGPT conversations directly
                                to Word or PDF.
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Converter Tool Card -->
                <div
                    class="bg-white border border-gray-200 rounded-2xl shadow-lg p-6 mb-6"
                >
                    <!-- Tool Header with Guide Link -->
                    <div class="flex justify-end mb-4">
                        <a
                            href="#how-to-use"
                            class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-blue-600 transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-3.5 w-3.5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                            How to Use Guide
                        </a>
                    </div>

                    <!-- Two Column Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <!-- Input Section -->
                        <div class="flex flex-col h-[650px]">
                            <div class="flex justify-between items-center mb-2">
                                <label
                                    class="block text-sm font-medium text-gray-700"
                                >
                                    <span class="flex items-center gap-2">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-4 w-4 text-blue-500"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                            ></path>
                                        </svg>
                                        Paste Word Content Here
                                    </span>
                                </label>
                                <div class="flex gap-2">
                                    <button
                                        id="paste-btn"
                                        class="px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-3.5 w-3.5"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                                            ></path>
                                        </svg>
                                        Paste
                                    </button>
                                    <button
                                        id="clear-btn"
                                        class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                                    >
