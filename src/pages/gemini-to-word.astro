---
import Layout from "~/layouts/PageLayout.astro";
import Sidebar from "~/components/widgets/Sidebar.astro";

const metadata = {
  title: "Convert Gemini to Word Online - Free",
  description:
    "Convert Google Gemini exports to Microsoft Word documents online. Preserves formatting, tables, and math equations.",
};
---

<Layout metadata={metadata}>
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-6">
      <!-- Main content area -->
      <div class="flex-1">
        <!-- Header Section -->
        <div class="text-center mb-6">
          <h1 class="text-2xl md:text-3xl font-bold text-blue-600 mb-3">
            Convert Gemini to Word Online
          </h1>
          <p class="text-gray-600 text-lg mb-4">
            Instantly transform Gemini content into formatted Word documents
          </p>
        </div>

        <!-- Google Workspace Promo -->
        <div
          class="bg-blue-50 border border-blue-200 rounded-xl p-4 w-full max-w-5xl mx-auto mb-6 shadow-sm flex flex-col md:flex-row items-center gap-4"
        >
          <div class="text-sm text-gray-700 leading-relaxed">
            <ul class="list-disc pl-4 space-y-1">
              <li>
                <strong>Pro Tip:</strong> Install the
                <a
                  href="https://chromewebstore.google.com/detail/gemini-to-word-pdf-google/edigonllaonjailplgnkhjeogbbgabpf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 font-semibold hover:underline"
                >
                  Gemini to Word Chrome Extension
                </a>
                to convert directly within Gemini.
              </li>
              <li>
                Preserves Math equations, Tables, and formatting automatically.
              </li>
            </ul>
          </div>
          <div class="flex-shrink-0">
            <a
              href="https://chromewebstore.google.com/detail/gemini-to-word-pdf-google/edigonllaonjailplgnkhjeogbbgabpf"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:opacity-90 transition-opacity duration-200 block"
            >
              <img
                src="https://workspace.google.com/static/img/marketplace/en/gwmBadge.svg?"
                alt="Get it from Chrome Web Store"
                class="h-12"
              />
            </a>
          </div>
        </div>

        <!-- Converter Tool Card -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-lg p-6 mb-6"
        >
          <!-- Tool Header with Guide Link -->
          <div class="flex justify-end mb-4">
            <a
              href="#how-to-use"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-blue-600 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              How to Use Guide
            </a>
          </div>

          <!-- Two Column Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="flex flex-col h-[500px]">
              <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-gray-700">
                  <span class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-blue-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                    Paste Gemini Content (Markdown)
                  </span>
                </label>
                <div class="flex gap-2">
                  <button
                    id="paste-btn"
                    class="px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                      ></path>
                    </svg>
                    Paste
                  </button>
                  <button
                    id="clear-btn"
                    class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      ></path>
                    </svg>
                    Clear
                  </button>
                </div>
              </div>
              <div class="relative flex-grow h-full">
                <textarea
                  id="input-markdown"
                  class="w-full h-full p-4 border border-gray-300 rounded-xl overflow-auto focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white resize-none font-mono text-sm"
                  placeholder="Paste your Gemini content here..."></textarea>
              </div>
            </div>

            <div class="flex flex-col h-[500px]">
              <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-gray-700">
                  <span class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-blue-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                    Word Document Preview
                  </span>
                </label>
                <div class="flex gap-2">
                  <button
                    id="download-btn"
                    class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200 shadow-sm"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                      ></path>
                    </svg>
                    Download Word
                  </button>
                </div>
              </div>
              <div class="relative flex-grow h-full">
                <div
                  id="preview-container"
                  class="w-full h-full p-4 border border-gray-300 rounded-xl overflow-auto bg-white prose max-w-none"
                >
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- How to Use Section -->
        <!-- Method 1 Card -->
        <div
          id="how-to-use"
          class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 mb-6"
        >
          <div>
            <!-- Method 1 Steps -->
            <div>
              <div class="mb-6">
                <h2
                  class="text-xl font-bold text-gray-900 flex items-center gap-2"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-blue-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                  Method 1: Using this Online Tool
                </h2>
                <p class="text-gray-600 mt-2 ml-8">
                  Best for quick conversions. Simply copy your Gemini response
                  and paste it here.
                </p>
              </div>
              <ol class="space-y-4 ml-8">
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >1</span
                  >
                  <span class="text-gray-700 font-medium"
                    >Paste your Gemini Markdown content in the left input box.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >2</span
                  >
                  <span class="text-gray-700 font-medium"
                    >The tool automatically converts it to a Word preview.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >3</span
                  >
                  <span class="text-gray-600"
                    >Click <strong>Download Word</strong> to save as a .docx file.</span
                  >
                </li>
              </ol>
            </div>
          </div>
        </div>

        <!-- Method 2 Card -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 mb-6"
        >
          <div class="mb-6">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-green-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
                ></path>
              </svg>
              Method 2: Using the Chrome Extension
            </h2>
            <p class="text-gray-600 mt-2 ml-8">
              Recommended for <span class="text-green-600 underline"
                >frequent users</span
              >. Convert directly from the Gemini interface.
            </p>
          </div>
          <ol class="space-y-4 ml-8">
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >1</span
              >
              <div class="flex flex-col gap-3">
                <span class="text-gray-700 font-medium">
                  Install the Gemini to Word or PDF extension.
                </span>
                <a
                  href="https://chromewebstore.google.com/detail/gemini-to-word-pdf-google/edigonllaonjailplgnkhjeogbbgabpf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block hover:opacity-90 transition-opacity duration-200"
                >
                  <img
                    src="https://workspace.google.com/static/img/marketplace/en/gwmBadge.svg?"
                    alt="Get it from Chrome Web Store"
                    class="h-10"
                  />
                </a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >2</span
              >
              <span class="text-gray-600"
                >Open <strong>Gemini</strong> and start a chat.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >3</span
              >
              <span class="text-gray-600"
                >Look for the <strong>Export</strong> buttons below each response.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >4</span
              >
              <span class="text-gray-600"
                >Click <strong>Word</strong> to download immediately.</span
              >
            </li>
          </ol>
        </div>
      </div>

      <!-- Sidebar -->
      <Sidebar height="10%" />
    </div>
  </div>
</Layout>

<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"
></script>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/html-docx-js@0.3.1/dist/html-docx.min.js"
></script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const inputTextarea = document.getElementById("input-markdown");
    const previewContainer = document.getElementById("preview-container");
    const pasteBtn = document.getElementById("paste-btn");
    const clearBtn = document.getElementById("clear-btn");
    const downloadBtn = document.getElementById("download-btn");

    function updatePreview() {
      if (!inputTextarea || !previewContainer) return;

      const content = inputTextarea.value;
      if (!content.trim()) {
        previewContainer.innerHTML =
          '<p class="text-gray-400 italic">Preview will appear here...</p>';
      } else {
        // Parse markdown to HTML
        const html = marked.parse(content);
        previewContainer.innerHTML = html;
      }
    }

    if (inputTextarea) {
      inputTextarea.addEventListener("input", updatePreview);
      // Initial call
      updatePreview();
    }

    if (pasteBtn) {
      pasteBtn.addEventListener("click", async function () {
        inputTextarea.focus();
        try {
          const text = await navigator.clipboard.readText();
          inputTextarea.value = text;
          updatePreview();
        } catch (err) {
          // Fallback or alert
          alert(
            "Please click inside the Input box and press Ctrl+V / Cmd+V to paste.",
          );
        }
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        if (inputTextarea) {
          inputTextarea.value = "";
          updatePreview();
          inputTextarea.focus();
        }
      });
    }

    if (downloadBtn) {
      downloadBtn.addEventListener("click", function () {
        if (!previewContainer || !inputTextarea.value.trim()) {
          alert("Please enter some content first.");
          return;
        }

        const htmlContent = previewContainer.innerHTML;
        const converted = htmlDocx.asBlob(htmlContent, {
          orientation: "landscape",
          margins: { top: 720 },
        });

        const url = URL.createObjectURL(converted);
        const a = document.createElement("a");
        a.href = url;
        a.download = "Gemini-Export.docx";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }
  });
</script>
