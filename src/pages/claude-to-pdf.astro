---
import Layout from "~/layouts/PageLayout.astro";
import Sidebar from "~/components/widgets/Sidebar.astro";

const metadata = {
  title: "Claude to PDF",
  description:
    "Convert Claude AI conversations to PDF format perfectly. Preserves formatting, math equations, and code blocks.",
};
---

<Layout metadata={metadata}>
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-6">
      <!-- Main content area -->
      <div class="flex-1">
        <!-- Header Section -->
        <div class="text-center mb-6">
          <h1 class="text-2xl md:text-3xl font-bold text-blue-600 mb-3">
            Convert Claude to PDF Online - Free
          </h1>
          <p class="text-gray-600 text-lg">
            Transform your Claude conversations into professionally formatted
            PDF documents instantly
          </p>
        </div>

        <!-- Chrome Extension Promo -->
        <div
          class="bg-blue-50 border border-blue-200 rounded-xl p-4 w-full max-w-5xl mx-auto mb-6 shadow-sm flex flex-col md:flex-row items-center gap-4"
        >
          <div class="text-sm text-gray-700 leading-relaxed">
            <ul class="list-disc pl-4 space-y-1">
              <li>
                <strong>Pro Tip:</strong> Use the
                <a
                  href="https://chromewebstore.google.com/detail/chatgpt-to-word-or-pdf/mjdmggegbkookpcmbdllcnbfboikcbop"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 font-semibold hover:underline"
                >
                  ChatGPT to Word or PDF Chrome extension
                </a>
                to export directly from the Claude interface.
              </li>
              <li>
                Preserves all formatting, math equations, and code blocks
                perfectly.
              </li>
            </ul>
          </div>
          <div class="flex-shrink-0">
            <a
              href="https://chromewebstore.google.com/detail/chatgpt-to-word-or-pdf/mjdmggegbkookpcmbdllcnbfboikcbop"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:opacity-90 transition-opacity duration-200 block"
            >
              <img
                src="/chrome-badge.png"
                alt="Get it from the Chrome Webstore"
                class="h-12"
              />
            </a>
          </div>
        </div>

        <!-- Converter Tool Card -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-lg p-6 mb-6"
        >
          <!-- Tool Header with Guide Link -->
          <div class="flex justify-end mb-4">
            <a
              href="#how-to-use"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-green-600 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              How to Use Guide
            </a>
          </div>

          <!-- Two Column Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <!-- Input Section -->
            <div class="flex flex-col h-[500px]">
              <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-gray-700">
                  <span class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-blue-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                      ></path>
                    </svg>
                    Claude Markdown Input
                  </span>
                </label>
                <div class="flex gap-2">
                  <button
                    id="paste-btn"
                    class="px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                      ></path>
                    </svg>
                    Paste
                  </button>
                  <button
                    id="clear-btn"
                    class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      ></path>
                    </svg>
                    Clear
                  </button>
                </div>
              </div>
              <div class="relative flex-grow h-full">
                <textarea
                  id="markdown-input"
                  class="w-full h-full p-4 border border-gray-300 rounded-xl text-base resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
                ></textarea>
                <!-- Centered Input Placeholder -->
                <div
                  id="input-placeholder"
                  class="absolute inset-0 flex items-center justify-center text-gray-400 text-base pointer-events-none"
                >
                  Paste your Claude markdown here...
                </div>
              </div>
            </div>

            <!-- Preview Section -->
            <div class="flex flex-col h-[500px]">
              <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-gray-700">
                  <span class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-green-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                    PDF Preview
                  </span>
                </label>
                <button
                  id="print-btn"
                  class="px-3 py-1.5 bg-green-500 hover:bg-green-600 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
                    ></path>
                  </svg>
                  Download / Print PDF
                </button>
              </div>
              <div
                id="preview-container"
                class="relative flex-grow border border-green-200 rounded-xl bg-green-50 overflow-hidden"
              >
                <div
                  id="markdown-preview"
                  class="absolute top-0 left-0 w-full h-full p-6 overflow-auto prose max-w-none"
                >
                </div>
                <!-- Centered Output Placeholder -->
                <div
                  id="output-placeholder"
                  class="absolute inset-0 flex items-center justify-center text-gray-400 text-base pointer-events-none"
                >
                  PDF Document preview will appear here...
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- How to Use Section -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 mb-6"
          id="how-to-use"
        >
          <div>
            <!-- Method 1 Steps -->
            <div>
              <div class="mb-6">
                <h2
                  class="text-xl font-bold text-gray-900 flex items-center gap-2"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-blue-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                  Method 1: Using this Online Tool
                </h2>
                <p class="text-gray-600 mt-2 ml-8">
                  Best for quick, one-off conversions. Simply copy content from
                  Claude and paste it here.
                </p>
              </div>
              <ol class="space-y-4 ml-8">
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >1</span
                  >
                  <span class="text-gray-700 font-medium"
                    >Paste your Claude content in the input box on the left.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >2</span
                  >
                  <span class="text-gray-700 font-medium"
                    >The text will be formatted automatically in the preview
                    box.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >3</span
                  >
                  <span class="text-gray-700 font-medium"
                    >Click "Download / Print PDF" to save your document.</span
                  >
                </li>
              </ol>
            </div>

            <!-- Video Tutorial - Hidden for future use
            <div>
              <h3
                class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-red-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Video Tutorial
              </h3>
              <div class="relative w-full" style="padding-bottom: 56.25%;">
                <iframe
                  class="absolute top-0 left-0 w-full h-full rounded-lg border border-gray-200"
                  src="https://www.youtube.com/embed/VIDEO_ID_HERE"
                  title="How to Convert Claude to PDF - Video Tutorial"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen></iframe>
              </div>
            </div>
            -->
          </div>
        </div>

        <!-- Method 2 Card -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 mb-6"
        >
          <div class="mb-6">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-green-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
                ></path>
              </svg>
              Method 2: Using the Chrome Extension
            </h2>
            <p class="text-gray-600 mt-2 ml-8">
              Recommended for <span class="text-green-600 underline"
                >frequent users</span
              >. Convert directly from Claude interface.
            </p>
          </div>
          <ol class="space-y-4 ml-8">
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >1</span
              >
              <div class="flex flex-col gap-3">
                <span class="text-gray-700 font-medium"
                  >Install the ChatGPT to Word/PDF extension.</span
                >
                <a
                  href="https://chromewebstore.google.com/detail/chatgpt-to-word-or-pdf/mjdmggegbkookpcmbdllcnbfboikcbop"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block hover:opacity-90 transition-opacity duration-200"
                >
                  <img
                    src="/chrome-badge.png"
                    alt="Get it from the Google Chrome Webstore"
                    class="h-10"
                  />
                </a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >2</span
              >
              <span class="text-gray-600"
                >Open your Claude conversation in the browser.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >3</span
              >
              <span class="text-gray-600"
                >Look for the "Export" buttons that appear below each response.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >4</span
              >
              <span class="text-gray-600"
                >Click <strong>PDF</strong> to download the content instantly.</span
              >
            </li>
          </ol>
        </div>
      </div>

      <!-- Sidebar -->
      <Sidebar height="10%" />
    </div>
  </div>
</Layout>

<!-- Add specific CSS to ensure fixed sizes -->
<style>
  /* Ensure content adheres to height limits */
  #markdown-input,
  #preview-container {
    height: 100%;
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"
></script>

<!-- KaTeX for Math Equations -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
/>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("markdown-input");
    const preview = document.getElementById("markdown-preview");
    const printBtn = document.getElementById("print-btn");
    const pasteBtn = document.getElementById("paste-btn");
    const clearBtn = document.getElementById("clear-btn");

    // Function to render math equations using KaTeX
    function renderMath(text) {
      if (!text) return "";

      // 1. Block Math: $$...$$
      text = text.replace(/\$\$([\s\S]+?)\$\$/g, function (match, math) {
        try {
          return katex.renderToString(math.trim(), {
            displayMode: true,
            throwOnError: false,
          });
        } catch (e) {
          return match;
        }
      });

      // 2. Block Math: \[...\]
      text = text.replace(/\\\[([\s\S]+?)\\\]/g, function (match, math) {
        try {
          return katex.renderToString(math.trim(), {
            displayMode: true,
            throwOnError: false,
          });
        } catch (e) {
          return match;
        }
      });

      // 3. Inline Math: $...$
      text = text.replace(
        /(?<!\$)\$(?!\$)([^\$\n]+?)\$(?!\$)/g,
        function (match, math) {
          try {
            return katex.renderToString(math.trim(), {
              displayMode: false,
              throwOnError: false,
            });
          } catch (e) {
            return match;
          }
        },
      );

      // 4. Inline Math: \(...\)
      text = text.replace(/\\\(([\s\S]+?)\\\)/g, function (match, math) {
        try {
          return katex.renderToString(math.trim(), {
            displayMode: false,
            throwOnError: false,
          });
        } catch (e) {
          return match;
        }
      });

      return text;
    }

    // Function to update the preview
    function updatePreview() {
      if (!input) return;

      const hasContent = !!input.value.trim();
      const inputPlaceholder = document.getElementById("input-placeholder");
      const outputPlaceholder = document.getElementById("output-placeholder");

      if (hasContent) {
        if (inputPlaceholder) inputPlaceholder.style.display = "none";
        if (outputPlaceholder) outputPlaceholder.style.display = "none";

        if (preview) {
          // First render math
          var textWithMath = renderMath(input.value);
          // Then convert markdown to HTML
          preview.innerHTML = marked.parse(textWithMath);
        }
      } else {
        if (inputPlaceholder) inputPlaceholder.style.display = "flex";
        if (outputPlaceholder) outputPlaceholder.style.display = "flex";
        if (preview) preview.innerHTML = "";
      }
    }

    // Initial render
    updatePreview();

    // Listen for input changes
    if (input) {
      input.addEventListener("input", updatePreview);
    }

    // Handle paste event
    if (pasteBtn) {
      pasteBtn.addEventListener("click", function () {
        navigator.clipboard
          .readText()
          .then(function (text) {
            if (input) {
              input.value = text;
              updatePreview();
            }
          })
          .catch(function (err) {
            console.error("Failed to read clipboard: ", err);
            alert("Unable to access clipboard. Please paste manually.");
          });
      });
    }

    // Handle clear input functionality
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        if (input) {
          input.value = "";
          updatePreview();
        }
      });
    }

    // Handle Native PDF/Print functionality
    if (printBtn) {
      printBtn.addEventListener("click", function () {
        const previewContent = document.getElementById("markdown-preview");
        if (previewContent) {
          // Create a hidden iframe
          const iframe = document.createElement("iframe");
          iframe.style.position = "absolute";
          iframe.style.width = "0";
          iframe.style.height = "0";
          iframe.style.border = "none";
          document.body.appendChild(iframe);

          // Get the document in the iframe
          const doc = iframe.contentWindow.document;

          // Write content with styles
          doc.write(`
            <html>
              <head>
                <title>Claude Conversation</title>
                <!-- Include KaTeX CSS -->
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
                <style>
                  body {
                    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                    line-height: 1.6;
                    color: #1a202c;
                    max-width: 800px;
                    margin: 0 auto;
                    padding: 40px;
                  }
                  h1, h2, h3, h4, h5, h6 { color: #1a202c; margin-top: 1.5em; margin-bottom: 0.5em; font-weight: 600; }
                  h1 { font-size: 2.25rem; }
                  h2 { font-size: 1.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.3em; }
                  p { margin-bottom: 1em; }
                  ul, ol { margin-bottom: 1em; padding-left: 1.5em; }
                  li { margin-bottom: 0.5em; }
                  code { background-color: #edf2f7; padding: 0.2em 0.4em; border-radius: 0.25rem; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; font-size: 0.875em; }
                  pre { background-color: #f7fafc; padding: 1em; border-radius: 0.5rem; overflow-x: auto; margin-bottom: 1em; border: 1px solid #e2e8f0; }
                  pre code { background-color: transparent; padding: 0; }
                  blockquote { border-left: 4px solid #cbd5e0; padding-left: 1em; margin-left: 0; color: #4a5568; font-style: italic; }
                  table { width: 100%; border-collapse: collapse; margin-bottom: 1em; }
                  th, td { border: 1px solid #e2e8f0; padding: 0.75em; text-align: left; }
                  th { background-color: #f7fafc; font-weight: 600; }
                  img { max-width: 100%; height: auto; border-radius: 0.5rem; }
                  
                  /* KaTeX specific adjustments */
                  .katex-display { margin: 1em 0; overflow-x: auto; overflow-y: hidden; }
                  
                  @media print {
                    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                    a { text-decoration: none; color: inherit; }
                    @page { margin: 2cm; }
                    /* Hide unnecessary elements if any leak through */
                    button, .no-print { display: none !important; }
                  }
                </style>
              </head>
              <body>
                ${previewContent.innerHTML}
                <script>
                   // Wait slightly for KaTeX fonts/styles to load then print
                   window.onload = function() {
                     setTimeout(function() {
                       window.print();
                     }, 500);
                   };
                <\/script>
              </body>
            </html>
          `);
          doc.close();

          // Cleanup
          setTimeout(() => {
            if (document.body.contains(iframe)) {
              document.body.removeChild(iframe);
            }
          }, 60000);
        }
      });
    }
  });

  // Simple input event handler for paste
  const inputArea = document.getElementById("markdown-input");
  if (inputArea) {
    inputArea.addEventListener("paste", () => {
      // Trigger update slightly after paste
      setTimeout(() => {
        const event = new Event("input");
        inputArea.dispatchEvent(event);
      }, 10);
    });
  }
</script>
