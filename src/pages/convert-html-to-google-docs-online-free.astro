---
import Layout from "~/layouts/PageLayout.astro";
import Sidebar from "~/components/widgets/Sidebar.astro";

const metadata = {
  title: "Convert HTML to Google Docs Online - Free",
  description:
    "Convert HTML code to Google Docs format. Paste your HTML, preview it as rich text, and copy-paste directly into Google Docs preserving formatting.",
};
---

<Layout metadata={metadata}>
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-6">
      <!-- Main content area -->
      <div class="flex-1">
        <!-- Header Section -->
        <div class="text-center mb-6">
          <h1 class="text-2xl md:text-3xl font-bold text-blue-600 mb-3">
            Convert HTML to Google Docs Online
          </h1>
          <p class="text-gray-600 text-lg">
            Transform raw HTML into Google Docs compatible rich text instantly
          </p>
        </div>

        <!-- Google Workspace Promo -->
        <div
          class="bg-blue-50 border border-blue-200 rounded-xl p-4 w-full max-w-5xl mx-auto mb-6 shadow-sm flex flex-col md:flex-row items-center gap-4"
        >
          <div class="text-sm text-gray-700 leading-relaxed">
            <ul class="list-disc pl-4 space-y-1">
              <li>
                <strong>Pro Tip:</strong> Install the
                <a
                  href="https://workspace.google.com/marketplace/app/docs_to_markdown_pro/483386994804"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 font-semibold hover:underline"
                >
                  Docs to Markdown Pro Add-on
                </a>
                User our Google Docs Addon to convert HTML to Google Docs directly
                within Google Docs.
              </li>
              <li>
                Preserves original HTML formatting, tables, images, and links.
              </li>
            </ul>
          </div>
          <div class="flex-shrink-0">
            <a
              href="https://workspace.google.com/marketplace/app/docs_to_markdown_pro/483386994804?pann=b"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:opacity-90 transition-opacity duration-200 block"
            >
              <img
                src="https://workspace.google.com/static/img/marketplace/en/gwmBadge.svg?"
                alt="Get it from the Google Workspace Marketplace"
                class="h-12"
              />
            </a>
          </div>
        </div>

        <!-- Converter Tool Card -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-lg p-6 mb-6"
        >
          <!-- Tool Header with Guide Link -->
          <div class="flex justify-end mb-4">
            <a
              href="#how-to-use"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-blue-600 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              How to Use Guide
            </a>
          </div>

          <!-- Two Column Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <!-- Input Section -->
            <div class="flex flex-col h-[650px]">
              <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-gray-700">
                  <span class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-blue-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                    </svg>
                    HTML Input
                  </span>
                </label>
                <div class="flex gap-2">
                  <button
                    id="paste-btn"
                    class="px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                      ></path>
                    </svg>
                    Paste
                  </button>
                  <button
                    id="clear-btn"
                    class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      ></path>
                    </svg>
                    Clear
                  </button>
                </div>
              </div>
              <div class="relative flex-grow h-full">
                <textarea
                  id="html-input"
                  class="w-full h-full p-4 border border-gray-300 rounded-xl font-mono text-sm resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
                  placeholder="Paste your HTML code here..."></textarea>
              </div>
            </div>

            <!-- Preview Section -->
            <div class="flex flex-col h-[650px]">
              <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-gray-700">
                  <span class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-green-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                    Rich Text Preview
                  </span>
                </label>
                <div class="flex gap-2">
                  <button
                    id="copy-btn"
                    class="px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"
                      ></path>
                    </svg>
                    Copy for Google Docs
                  </button>
                </div>
              </div>
              <div
                class="relative flex-grow border border-green-200 rounded-xl bg-green-50 overflow-hidden"
              >
                <div
                  id="preview-container"
                  class="absolute top-0 left-0 w-full h-full p-6 overflow-auto prose max-w-none"
                >
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- How to Use Section -->

        <!-- Method 1 Card -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 mb-6 scroll-mt-24"
          id="how-to-use"
        >
          <div>
            <!-- Method 1 Steps -->
            <div>
              <div class="mb-6">
                <h2
                  class="text-xl font-bold text-gray-900 flex items-center gap-2"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-blue-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                  Method 1: Using this Online Tool
                </h2>
                <p class="text-gray-600 mt-2 ml-8">
                  Best for quick conversions. Simply paste your HTML and copy
                  the result.
                </p>
              </div>
              <ol class="space-y-4 ml-8">
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >1</span
                  >
                  <span class="text-gray-700 font-medium"
                    >Paste your HTML content in the Input text box.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >2</span
                  >
                  <span class="text-gray-700 font-medium"
                    >The tool automatically converts it to Google Docs format.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >3</span
                  >
                  <span class="text-gray-600"
                    >Click <strong>Copy for Google Docs</strong> to copy the formatted
                    text.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >4</span
                  >
                  <span class="text-gray-600"
                    >Paste (Ctrl+V / Cmd+V) directly into your Google Doc.</span
                  >
                </li>
              </ol>
            </div>

            <!-- Video Tutorial - Hidden for future use
            <div>
              <h3
                class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-red-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Video Tutorial
              </h3>
              <div class="relative w-full" style="padding-bottom: 56.25%;">
                <iframe
                  class="absolute top-0 left-0 w-full h-full rounded-lg border border-gray-200"
                  src="https://www.youtube.com/embed/VIDEO_ID_HERE"
                  title="How to Convert HTML to Google Docs - Video Tutorial"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen></iframe>
              </div>
            </div>
            -->
          </div>
        </div>

        <!-- Method 2 Card -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 mb-6"
        >
          <div class="mb-6">
            <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-green-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
                ></path>
              </svg>
              Method 2: Using the Google Docs Add-on
            </h2>
            <p class="text-gray-600 mt-2 ml-8">
              Recommended for <span class="text-green-600 underline"
                >frequent users</span
              >. Convert directly within Google Docs without switching tabs.
            </p>
          </div>
          <ol class="space-y-4 ml-8">
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >1</span
              >
              <div class="flex flex-col gap-3">
                <span class="text-gray-700 font-medium"
                  >Install the Docs to Markdown Pro extension.</span
                >
                <a
                  href="https://workspace.google.com/marketplace/app/docs_to_markdown_pro/483386994804"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block hover:opacity-90 transition-opacity duration-200"
                >
                  <img
                    src="https://workspace.google.com/static/img/marketplace/en/gwmBadge.svg?"
                    alt="Get it from the Google Workspace Marketplace"
                    class="h-10"
                  />
                </a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >2</span
              >
              <span class="text-gray-600"
                >Open any Google Doc, go to <strong
                  >Extensions > Docs to Markdown Pro</strong
                >.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >3</span
              >
              <span class="text-gray-600"
                >Select <strong>Markdown/HTML to Docs</strong> to see the sidebar.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >4</span
              >
              <span class="text-gray-600"
                >Paste your HTML code into the sidebar.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                >5</span
              >
              <span class="text-gray-600"
                >Click the <strong>Insert to Docs</strong> button.</span
              >
            </li>
          </ol>
        </div>
      </div>

      <!-- Sidebar -->
      <Sidebar height="10%" />
    </div>
  </div>
</Layout>

<style>
  #html-input,
  #preview-container {
    height: 100%;
  }
</style>

<!-- KaTeX for Math Equations -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
/>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("html-input");
    const preview = document.getElementById("preview-container");
    const copyBtn = document.getElementById("copy-btn");
    const pasteBtn = document.getElementById("paste-btn");
    const clearBtn = document.getElementById("clear-btn");

    function renderMath(text) {
      if (!text) return "";
      // Process block math ($$...$$)
      text = text.replace(/\$\$([\s\S]+?)\$\$/g, function (match, math) {
        try {
          return katex.renderToString(math.trim(), {
            displayMode: true,
            throwOnError: false,
          });
        } catch (e) {
          return match;
        }
      });
      // Process inline math ($...$)
      text = text.replace(
        /(?<!\$)\$(?!\$)([^\$\n]+?)\$(?!\$)/g,
        function (match, math) {
          try {
            return katex.renderToString(math.trim(), {
              displayMode: false,
              throwOnError: false,
            });
          } catch (e) {
            return match;
          }
        },
      );
      return text;
    }

    function updatePreview() {
      if (preview && input) {
        const textWithMath = renderMath(input.value);
        preview.innerHTML = textWithMath;
      }
    }

    if (input) {
      input.addEventListener("input", updatePreview);
    }

    if (pasteBtn) {
      pasteBtn.addEventListener("click", function () {
        navigator.clipboard
          .readText()
          .then((text) => {
            if (input) {
              input.value = text;
              updatePreview();
            }
          })
          .catch((err) => {
            console.error("Failed to read clipboard:", err);
            alert("Unable to access clipboard.");
          });
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        if (input) {
          input.value = "";
          updatePreview();
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", function () {
        if (!preview) return;

        // Create a temporary Blob with the HTML content for rich copying
        const blob = new Blob([preview.innerHTML], { type: "text/html" });
        // We also provide plain text fallback if possible, but clipboard API 'write' supports specific items
        // For Google Docs, text/html is what triggers the rich paste
        const item = new ClipboardItem({
          "text/html": blob,
          "text/plain": new Blob([preview.innerText], { type: "text/plain" }),
        });

        navigator.clipboard
          .write([item])
          .then(() => {
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Copied!
            `;
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
            }, 2000);
          })
          .catch((err) => {
            console.error("Copy failed", err);
            alert(
              "Failed to copy rich text. Please manually select all text in preview and copy.",
            );
          });
      });
    }
  });
</script>
