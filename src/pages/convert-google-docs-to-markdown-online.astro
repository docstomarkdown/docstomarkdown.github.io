<style>
    /* Basic contenteditable styling */
    [contenteditable]:empty:before {
        content: attr(placeholder);
        color: #9ca3af;
        display: block; /* For Firefox */
    }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/turndown/dist/turndown.js"
></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"
></script>
<script is:inline>
    window.MathJax = {
        tex: {
            inlineMath: [
                ["$", "$"],
                ["\\(", "\\)"],
            ],
            displayMath: [
                ["$$", "$$"],
                ["\\[", "\\]"],
            ],
        },
        svg: {
            fontCache: "global",
        },
    };
</script>
<script
    is:inline
    id="MathJax-script"
    async
    src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
        const inputDiv = document.getElementById("rich-input");
        const outputTextarea = document.getElementById("markdown-output");
        const placeholder = document.getElementById("input-placeholder");
        const copyBtn = document.getElementById("copy-md-btn");
        const pasteBtn = document.getElementById("paste-btn");
        const clearBtn = document.getElementById("clear-btn");
        const downloadBtn = document.getElementById("download-md-btn");

        // Initialize Turndown Service
        let turndownService;
        if (typeof TurndownService !== "undefined") {
            turndownService = new TurndownService({
                headingStyle: "atx",
                codeBlockStyle: "fenced",
                emDelimiter: "_",
            });
        } else {
            console.error("TurndownService not loaded");
        }

        function convertToMarkdown(html) {
            if (!html || !turndownService) return "";

            // Pre-process HTML to fix Google Docs quirks
            html = html.replace(/&nbsp;/g, " ");
            html = html.replace(
                /<li[^>]*>\s*<p[^>]*>([\s\S]*?)<\/p>\s*<\/li>/gi,
                "<li>$1</li>",
            );
            html = html.replace(/<p[^>]*>\s*(<br\s*\/?>)?\s*<\/p>/gi, "");

            // Pre-process: Protect math blocks from Turndown escaping
            const mathTokens = [];

            // Helper to tokenize math
            const tokenize = (content, isBlock) => {
                const temp = document.createElement("div");

                // Preserving newlines: Replace common block breaks with newlines before decoding
                let processedMatch = content
                    .replace(/<br\s*\/?>/gi, "\n")
                    .replace(/<\/p>/gi, "\n")
                    .replace(/<\/div>/gi, "\n");

                temp.innerHTML = processedMatch;

                // Get text content and clean up whitespace
                let text = (temp.textContent || temp.innerText || "").trim();

                // Normalize newlines (collapse multiple empty lines)
                text = text.replace(/\n\s*\n/g, "\n");

                if (isBlock) {
                    text = `$$\n${text}\n$$`;
                } else {
                    text = `$${text}$`;
                }

                mathTokens.push(text);
                return "MATHPH" + (mathTokens.length - 1) + "ENDMATHPH";
            };

            // 1. Protect Block Math $$...$$ and \[...\]
            // Relaxed Regex: Allows HTML tags or whitespace between characters (e.g. <span>\</span><span>[</span>)
            let protectedHtml = html.replace(
                /\$\$(?:<[^>]+>|\s)*([\s\S]+?)(?:<[^>]+>|\s)*\$\$/g,
                (match, content) => tokenize(content, true),
            );
            protectedHtml = protectedHtml.replace(
                /\\(?:<[^>]+>|\s)*\[([\s\S]+?)\\(?:<[^>]+>|\s)*\]/g,
                (match, content) => tokenize(content, true),
            );

            // 1b. Protect "Loose" Bracket Blocks: [ ... ] with newlines (Common in user's copy-paste)
            // Matches [ followed by block/line breaks, content, block/line breaks, then ]
            // We use capturing groups ($1 and $3) for the boundaries to ensure we don't accidentally swallow > or <
            protectedHtml = protectedHtml.replace(
                /(^|>|\s)\s*\[\s*(?:<br\s*\/?>|<\/?div>|<\/?p>|\n|&nbsp;)+([\s\S]+?)(?:<br\s*\/?>|<\/?div>|<\/?p>|\n|&nbsp;)+\s*\]\s*($|<|\s)/gi,
                (match, pre, content, post) =>
                    pre + tokenize(content, true) + post,
            );

            // 2. Protect Inline Math $...$ and \(...\)
            protectedHtml = protectedHtml.replace(
                /(?<!\$)\$(?!\$)(?:<[^>]+>|\s)*([^\$\n]+?)(?:<[^>]+>|\s)*\$(?!\$)/g,
                (match, content) => tokenize(content, false),
            );
            protectedHtml = protectedHtml.replace(
                /\\(?:<[^>]+>|\s)*\(([\s\S]+?)\\(?:<[^>]+>|\s)*\)/g,
                (match, content) => tokenize(content, false),
            );

            // 3. Protect "Loose" LaTeX Symbols (Greek letters, etc. without delimiters)
            // This fixes (\pi) becoming (\\pi)
            const looseSymbols = [
                "alpha",
                "beta",
                "gamma",
                "delta",
                "epsilon",
                "zeta",
                "eta",
                "theta",
                "iota",
                "kappa",
                "lambda",
                "mu",
                "nu",
                "xi",
                "omicron",
                "pi",
                "rho",
                "sigma",
                "tau",
                "upsilon",
                "phi",
                "chi",
                "psi",
                "omega",
                "Gamma",
                "Delta",
                "Theta",
                "Lambda",
                "Xi",
                "Pi",
                "Sigma",
                "Phi",
                "Psi",
                "Omega",
                "int",
                "sum",
                "prod",
                "sqrt",
                "frac",
                "partial",
                "nabla",
                "infty",
                "approx",
                "sim",
                "cong",
                "pm",
                "mp",
                "times",
                "div",
                "cdot",
                "neq",
                "leq",
                "geq",
            ];
            const symbolRegex = new RegExp(
                `\\\\(${looseSymbols.join("|")})`,
                "g",
            );
            protectedHtml = protectedHtml.replace(symbolRegex, (match) =>
                tokenize(match, false),
            );

            // Convert to Markdown
            let markdown = turndownService.turndown(protectedHtml);

            // Restore Math Tokens
            mathTokens.forEach((token, index) => {
                const placeholder = "MATHPH" + index + "ENDMATHPH";
                markdown = markdown.replace(placeholder, () => token);
            });

            // Post-process Markdown to fix common annoyances
            markdown = markdown.replace(/^(#{1,6}\s+\d+)\\\./gm, "$1.");
            markdown = markdown.replace(
                /^(\s*[-*+] .*?)(\n{2,})(?=\s*[-*+])/gm,
                "$1\n",
            );
            markdown = markdown.replace(
                /^(\s*\d+\. .*?)(\n{2,})(?=\s*\d+\.)/gm,
                "$1\n",
            );
            markdown = markdown.replace(/\n{3,}/g, "\n\n");

            return markdown.trim();
        }

        function updateOutput() {
            if (!inputDiv || !outputTextarea) return;

            const content = inputDiv.innerHTML;
            const textContent = inputDiv.textContent;

            if (!textContent.trim() && !inputDiv.querySelector("img")) {
                outputTextarea.value = "";
                if (placeholder) placeholder.style.display = "block";
            } else {
                if (placeholder) placeholder.style.display = "none";
                outputTextarea.value = convertToMarkdown(content);
            }
        }

        if (inputDiv) {
            inputDiv.addEventListener("input", updateOutput);

            // Handle paste events
            inputDiv.addEventListener("paste", function (e) {
                // Allow browser to handle paste to get rich text/HTML
                setTimeout(updateOutput, 0);
            });
        }

        if (pasteBtn) {
            pasteBtn.addEventListener("click", async function () {
                inputDiv.focus();
                try {
                    const clipboardItems = await navigator.clipboard.read();
                    for (const item of clipboardItems) {
                        if (item.types.includes("text/html")) {
                            const blob = await item.getType("text/html");
                            const html = await blob.text();
                            inputDiv.innerHTML = html;
                            updateOutput();
                            return;
                        }
                    }
                    // Fallback if no HTML or read fails (e.g. permission)
                    const text = await navigator.clipboard.readText();
                    inputDiv.innerText = text; // Plain text
                    updateOutput();
                } catch (e) {
                    alert(
                        "Please click inside the Input box and press Ctrl+V / Cmd+V to paste with formatting.",
                    );
                }
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener("click", function () {
                if (inputDiv) {
                    inputDiv.innerHTML = "";
                    updateOutput();
                    inputDiv.focus();
                }
            });
        }

        if (copyBtn) {
            copyBtn.addEventListener("click", function () {
                if (!outputTextarea || !outputTextarea.value) return;

                outputTextarea.select();
                navigator.clipboard
                    .writeText(outputTextarea.value)
                    .then(() => {
                        const originalText = copyBtn.innerHTML;
                        copyBtn.innerHTML = `Copied!`;
                        setTimeout(() => {
                            copyBtn.innerHTML = originalText;
                        }, 2000);
                    })
                    .catch((err) => {
                        console.error("Copy failed", err);
                    });
            });
        }

        if (downloadBtn) {
            downloadBtn.addEventListener("click", function () {
                if (!outputTextarea || !outputTextarea.value) return;
                const blob = new Blob([outputTextarea.value], {
                    type: "text/markdown",
                });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = "document.md";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            });
        }
    });
</script>
