---
import Layout from "~/layouts/PageLayout.astro";
import Sidebar from "~/components/widgets/Sidebar.astro";

const metadata = {
  title: "Markdown Table of Contents Generator - Free Online Tool",
  description:
    "Automatically generate a Table of Contents (TOC) for your Markdown documents. Paste your content and get a linked TOC instantly.",
};
---

<Layout metadata={metadata}>
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-6">
      <!-- Main content area -->
      <div class="flex-1">
        <!-- Header Section -->
        <div class="text-center mb-6">
          <h1 class="text-3xl md:text-4xl font-bold text-blue-600 mb-3">
            Markdown Table of Contents Generator
          </h1>
          <p class="text-gray-600 text-lg">
            Instantly create a Table of Contents for your Markdown files
          </p>
        </div>

        <!-- Google Workspace Promo -->
        <div
          class="bg-blue-50 border border-blue-200 rounded-xl p-4 w-full max-w-5xl mx-auto mb-6 shadow-sm flex flex-col md:flex-row items-center gap-4"
        >
          <div class="text-sm text-gray-700 leading-relaxed">
            <ul class="list-disc pl-4 space-y-1">
              <li>
                <strong>Pro Tip:</strong> Install the
                <a
                  href="https://workspace.google.com/marketplace/app/docs_to_markdown_pro/483386994804"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 font-semibold hover:underline"
                >
                  Docs to Markdown Pro Add-on
                </a>
                to generate Table of Contents directly inside Google Docs.
              </li>
              <li>
                Supports automatic anchor link generation for easy navigation.
              </li>
            </ul>
          </div>
          <div class="flex-shrink-0">
            <a
              href="https://workspace.google.com/marketplace/app/docs_to_markdown_pro/483386994804?pann=b"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:opacity-90 transition-opacity duration-200 block"
            >
              <img
                src="https://workspace.google.com/static/img/marketplace/en/gwmBadge.svg?"
                alt="Get it from the Google Workspace Marketplace"
                class="h-12"
              />
            </a>
          </div>
        </div>

        <!-- Converter Tool Card -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-lg p-6 mb-6"
        >
          <!-- Tool Header -->
          <div class="flex justify-end mb-4">
            <a
              href="#how-to-use"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-green-600 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              How to Use Guide
            </a>
          </div>

          <!-- Two Column Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <!-- Input Section -->
            <div class="flex flex-col h-[500px]">
              <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-gray-700">
                  <span class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-blue-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                    Markdown Input
                  </span>
                </label>
                <div class="flex gap-2">
                  <button
                    id="paste-btn"
                    class="px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                      ></path>
                    </svg>
                    Paste
                  </button>
                  <button
                    id="clear-btn"
                    class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      ></path>
                    </svg>
                    Clear
                  </button>
                </div>
              </div>
              <div class="relative flex-grow h-full">
                <textarea
                  id="markdown-input"
                  class="w-full h-full p-4 border border-gray-300 rounded-xl text-base resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 hover:bg-white"
                ></textarea>
                <!-- Centered Input Placeholder -->
                <div
                  id="input-placeholder"
                  class="absolute inset-0 flex items-center justify-center text-gray-400 text-base pointer-events-none"
                >
                  Paste your Markdown here...
                </div>
              </div>
            </div>

            <!-- Preview Section -->
            <div class="flex flex-col h-[500px]">
              <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-gray-700">
                  <span class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-green-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                      ></path>
                    </svg>
                    Generated (Table of Contents)
                  </span>
                </label>
                <div class="flex gap-2">
                  <button
                    id="copy-btn"
                    class="px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg flex items-center gap-1.5 text-xs font-medium transition-all duration-200"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3.5 w-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"
                      ></path>
                    </svg>
                    Copy Table of Contents
                  </button>
                </div>
              </div>
              <div
                class="relative flex-grow border border-green-200 rounded-xl bg-green-50 overflow-hidden"
              >
                <!-- This is the raw text area for output to facilitate easy copying of CODE -->
                <textarea
                  id="toc-output"
                  readonly
                  class="w-full h-full p-4 font-mono text-sm resize-none focus:outline-none bg-green-50 text-gray-700"
                ></textarea>
                <!-- Centered Output Placeholder -->
                <div
                  id="output-placeholder"
                  class="absolute inset-0 flex items-center justify-center text-gray-400 text-base pointer-events-none"
                >
                  Table of Contents will appear here...
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- How to Use Section -->
        <div
          class="bg-white border border-gray-200 rounded-2xl shadow-sm p-8 mb-6"
        >
          <div class="flex flex-col gap-6">
            <!-- Left: Method 1 -->
            <div>
              <div class="mb-6">
                <h2
                  class="text-xl font-bold text-gray-900 flex items-center gap-2"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-blue-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                  Method 1: Using this Online Tool
                </h2>
                <p class="text-gray-600 mt-2 ml-8">
                  Best for quick, one-off conversions. Simply paste your
                  Markdown and get the Table of Contents.
                </p>
              </div>
              <ol class="space-y-4 ml-8">
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >1</span
                  >
                  <span class="text-gray-700 font-medium"
                    >Paste your Markdown content in the input box on the left.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >2</span
                  >
                  <span class="text-gray-700 font-medium"
                    >The Table of Contents will be generated automatically in
                    the output box.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >3</span
                  >
                  <span class="text-gray-700 font-medium"
                    >Click "Copy Table of Contents" to copy the links.</span
                  >
                </li>
              </ol>
            </div>

            <!-- Right: Method 2 -->
            <div>
              <div class="mb-6">
                <h2
                  class="text-xl font-bold text-gray-900 flex items-center gap-2"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 text-green-600"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"
                    ></path>
                  </svg>
                  Method 2: Using Docs to Markdown Pro
                </h2>
                <p class="text-gray-600 mt-2 ml-8">
                  Recommended for
                  <span class="text-green-600 underline">frequent users</span>.
                  Generate Table of Contents directly in Google Docs.
                </p>
              </div>
              <ol class="space-y-4 ml-8">
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >1</span
                  >
                  <div class="flex flex-col gap-3">
                    <span class="text-gray-700 font-medium"
                      >Install Docs to Markdown Pro.</span
                    >
                    <a
                      href="https://workspace.google.com/marketplace/app/docs_to_markdown_pro/483386994804"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block hover:opacity-90 transition-opacity duration-200"
                    >
                      <img
                        src="https://workspace.google.com/static/img/marketplace/en/gwmBadge.svg?"
                        alt="Get it from the Google Workspace Marketplace"
                        class="h-10"
                      />
                    </a>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >2</span
                  >
                  <span class="text-gray-600"
                    >Open your document in Google Docs.</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <span
                    class="flex-shrink-0 w-6 h-6 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-sm font-semibold"
                    >3</span
                  >
                  <span class="text-gray-600"
                    >Use the add-on to insert a Table of Contents instantly.</span
                  >
                </li>
              </ol>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <Sidebar height="10%" />
    </div>
  </div>
</Layout>

<style>
  #markdown-input,
  #toc-output {
    height: 100%;
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"
></script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("markdown-input");
    const output = document.getElementById("toc-output");
    const copyBtn = document.getElementById("copy-btn");
    const pasteBtn = document.getElementById("paste-btn");
    const clearBtn = document.getElementById("clear-btn");

    function generateTOC() {
      if (!input || !output || typeof marked === "undefined") return;

      const textContent = input.value;
      const inputPlaceholder = document.getElementById("input-placeholder");
      const outputPlaceholder = document.getElementById("output-placeholder");

      if (!textContent.trim()) {
        output.value = "";
        if (inputPlaceholder) inputPlaceholder.style.display = "flex";
        if (outputPlaceholder) outputPlaceholder.style.display = "flex";
        return;
      }

      if (inputPlaceholder) inputPlaceholder.style.display = "none";
      if (outputPlaceholder) outputPlaceholder.style.display = "none";

      try {
        const tokens = marked.lexer(textContent);
        let toc = "## Table of Contents\n\n";
        let hasHeadings = false;

        tokens.forEach((token) => {
          if (token.type === "heading") {
            hasHeadings = true;
            const level = token.depth;
            const text = token.text;
            // Simplified slug generation
            const slug = text
              .toLowerCase()
              .replace(/[^\w\s-]/g, "") // Remove special chars
              .replace(/\s+/g, "-"); // Replace spaces with hyphens

            // Indent based on level (2 spaces per level minus 1)
            // If level 1, indent 0. Level 2, indent 2 spaces.
            const indent = "  ".repeat(Math.max(0, level - 1));
            toc += `${indent}- [${text}](#${slug})\n`;
          }
        });

        if (hasHeadings) {
          output.value = toc;
        } else {
          output.value = ""; // No headings found
        }
      } catch (e) {
        console.error("Error generating TOC:", e);
      }
    }

    if (input) {
      input.addEventListener("input", generateTOC);
    }

    if (pasteBtn) {
      pasteBtn.addEventListener("click", function () {
        navigator.clipboard
          .readText()
          .then((text) => {
            if (input) {
              input.value = text;
              generateTOC();
            }
          })
          .catch((err) => {
            console.error("Failed to read clipboard:", err);
            alert("Unable to access clipboard.");
          });
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        if (input) {
          input.value = "";
          output.value = "";
          input.focus();
          generateTOC();
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", function () {
        if (!output || !output.value) return;

        output.select();
        navigator.clipboard
          .writeText(output.value)
          .then(() => {
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Copied!
            `;
            setTimeout(() => {
              copyBtn.innerHTML = originalText;
            }, 2000);
          })
          .catch((err) => {
            console.error("Copy failed", err);
            alert("Failed to copy content.");
          });
      });
    }
  });
</script>
